{
  "headers": [
    {
      "source": "/assets/(img|video|fonts|js)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/case-quickfleet",
      "destination": "/work/quickfleet",
      "permanent": true
    },
    {
      "source": "/index",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/case-pantech",
      "destination": "/work/pantech",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/work/quickfleet",
      "destination": "/case-quickfleet"
    },
    {
      "source": "/work/pantech",
      "destination": "/case-pantech"
    }
  ]
}